{
  "rules": {
    ".read": false,
    ".write": false,
    "onlinePlayers": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "matchQueue": {
      "$mode": {
        ".read": "auth != null",
        ".indexOn": ["createdAt"],
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },
    "pairLocks": {
      "$pairId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "matches": {
      "$matchId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "challengeResults": {
      ".read": true,
      "$mode": {
        "$resultId": {
          ".write": "auth != null"
        }
      }
    },
    "challengePlayCounts": {
      ".read": true,
      "$mode": {
        ".write": "auth != null"
      }
    },
    "challengePlayEvents": {
      ".read": true,
      "$mode": {
        "$eventId": {
          ".write": "auth != null"
        }
      }
    },
    "draftPlayers": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "draftQueue": {
      "$mode": {
        ".read": "auth != null",
        ".indexOn": ["createdAt"],
        "$uid": {
          ".write": "auth != null"
        }
      }
    },
    "draftPairLocks": {
      "$pairId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "draftMatches": {
      "$matchId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
